APP_NAME=ShipmentIQ API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://shipmentiq_dev:change-me-locally@localhost:5432/shipmentiq
DB_CONNECT_TIMEOUT=3
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=shipmentiq
JWT_AUDIENCE=shipmentiq-api
JWT_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=shipmentiq_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_CSRF_COOKIE_NAME=shipmentiq_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_USERS=false
DEMO_EXECUTIVE_EMAIL=executive@example.test
DEMO_EXECUTIVE_PASSWORD=replace-with-a-local-demo-password
DEMO_MANAGER_EMAIL=manager@example.test
DEMO_MANAGER_PASSWORD=replace-with-a-local-demo-password
DOCUMENT_STORAGE_PATH=private_storage/documents
DOCUMENT_MAX_SIZE_BYTES=10485760
OCR_PROVIDER=local
EXTRACTION_AI_PROVIDER=local
# Optional OpenAI-compatible endpoint. Leave unset for the free local labelled-text provider.
# EXTRACTION_AI_API_URL=
# EXTRACTION_AI_API_KEY=
EXTRACTION_AI_MODEL=configured-model
EXTRACTION_AI_TIMEOUT_SECONDS=60
EXTRACTION_LOW_CONFIDENCE_THRESHOLD=0.80
